# One OpenRouter key is used for jev and every comparison model.
OPENROUTER_API_KEY=sk-or-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenRouter model id used as "jev" (a decision model: called through /api/alpha/decisions)
JEV_MODEL=typesafe/jev-1.13
# Comma-separated OpenRouter model ids to compare against jev
COMPARE_MODELS=openai/gpt-5.4-mini,anthropic/claude-haiku-5.5,google/gemini-3.8-flash,qwen/qwen3.6-35b-a3b,google/gemma-4-26b-a4b-it

# Editable list of teams (read at startup)
TEAMS_FILE=teams.yaml
# Editable customer tiers (read at startup)
TIERS_FILE=tiers.yaml
# Editable severity ranks (read at startup)
SEVERITY_FILE=severity.yaml

# Agent Skills: folders with SKILL.md, added to the prompt when their triggers match
SKILLS_DIR=skills
MAX_SKILLS_PER_TICKET=3

# Auto-assign thresholds: both must be met (and urgency != critical)
AUTO_ASSIGN_MIN_PROB=0.80
AUTO_ASSIGN_MIN_CONFIDENCE=0.80
# What triggers human review: default (team checks + confidence + critical urgency),
# team (only team probability/tie/confidence) or urgency (only critical / urgency probability / confidence)
HUMAN_REVIEW_MODE=default

MAX_CONCURRENCY=4
REQUEST_TIMEOUT=60
